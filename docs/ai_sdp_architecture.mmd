    %% ── SOURCE VOLUME ───────────────────────────────────────────
    SRC[("Raw Documents<br/>PDF · DOCX · PNG<br/>Unity Catalog Volume")]

    %% ── LAKEFLOW SPARK DECLARATIVE PIPELINE ────────────────────
    subgraph PIPE["⚙  Lakeflow Spark Declarative Pipeline  (single SDP)"]
    direction TB

        BRONZE["bronze_documents<br/><b>STREAMING TABLE</b><br/>raw bytes · provenance · source path"]

        SILVER_PAR["silver_parsed<br/><b>STREAMING TABLE</b><br/>parsed once · body text<br/>is_valid · error_status"]

        SILVER_DOC["silver_documents<br/><b>STREAMING TABLE</b><br/>valid documents only<br/>topic · sentiment"]

        SILVER_CHK["silver_chunks<br/><b>STREAMING TABLE</b><br/>one row per chunk<br/>1024-dim embedding · embed-once"]

        GOLD("gold_rag_chunks<br/><b>MATERIALIZED VIEW</b><br/>curated · retrieval-ready<br/>exposes Change Data Feed")

    end

    %% ── PIPELINE EDGES ──────────────────────────────────────────
    SRC        -->|"Auto Loader — cloudFiles, binaryFile"| BRONZE
    BRONZE     -->|"ai_parse_document → text"| SILVER_PAR
    SILVER_PAR -->|"WHERE is_valid<br/>ai_classify · ai_analyze_sentiment"| SILVER_DOC
    SILVER_PAR -->|"WHERE is_valid<br/>ai_prep_search → chunks  ·  posexplode<br/>ai_query → embeddings (gte‑large‑en)"| SILVER_CHK
    SILVER_CHK -->|"valid chunks — zero AI function calls"| GOLD
    SILVER_DOC -->|"topic · sentiment, join on doc_id"| GOLD

    %% ── VECTOR SEARCH INDEX + CONSUMERS (parallel) ──────────────
    VSIDX[/"gold_rag_chunks_index<br/><b>AI SEARCH INDEX</b>  —  DELTA_SYNC<br/>self-managed embeddings · pk: chunk_id"\]

    subgraph CONS["Downstream Consumers  (read from gold table / index)"]
    direction LR
        C1(["RAG agent<br/>Databricks App"])
        C2(["Genie<br/>NL analytics"])
        C3(["AI/BI<br/>Dashboards"])
        C4(["Model Serving<br/>feature lookup"])
    end

    GOLD -->|"Delta Sync (triggered)<br/>synced by the job after each run"| VSIDX
    GOLD --> C1
    GOLD --> C2
    GOLD --> C3
    GOLD --> C4

    %% ── LEGEND (placed below via invisible anchor) ───────────────
    subgraph LEG["Legend"]
    direction LR
        L1["STREAMING TABLE"]
        L2("MATERIALIZED VIEW")
        L3[/"AI SEARCH INDEX"\]
        L4[("Source Volume")]
        L5(["Downstream Consumer"])
        L1 ~~~ L2 ~~~ L3 ~~~ L4 ~~~ L5
    end

    VSIDX ~~~ LEG
    CONS  ~~~ LEG

